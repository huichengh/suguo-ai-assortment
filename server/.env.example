# 苏果智选 · 后台环境变量示例
#
# 复制为 .env 后按需修改。全部配置都有可运行的默认值，
# 不配置也能直接启动（默认 SQLite + 内置 JWT 密钥）。
# 生产部署时必须替换 SUGUO_JWT_SECRET。

# 数据库连接。默认 SQLite 单文件，克隆即跑；接生产库改这一行即可。
# SQLite：    sqlite:///./suguo.db
# PostgreSQL：postgresql+psycopg://user:pass@127.0.0.1:5432/suguo
SUGUO_DATABASE_URL=sqlite:///./suguo.db

# JWT 密钥。生产必须改为强随机值，例如：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SUGUO_JWT_SECRET=suguo-ai-assortment-demo-secret-change-in-production

# 令牌有效期（分钟）
SUGUO_ACCESS_TOKEN_EXPIRE_MINUTES=120

# 调试开关
SUGUO_DEBUG=true
